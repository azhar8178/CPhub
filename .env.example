# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://cphub:your_password@localhost:5432/cphub
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── Server port ───────────────────────────────────────────────────────────────
PORT=3001

# ── Public site URL (used for canonical URLs, OG tags, sitemap) ───────────────
VITE_SITE_URL=https://cloudpartnerhub.com

# ── Email delivery (optional — for password resets & campaigns) ───────────────
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM="Cloud Partner Hub <hello@cloudpartnerhub.com>"

# ── Docker Compose only ───────────────────────────────────────────────────────
POSTGRES_PASSWORD=your_postgres_password
APP_PORT=3001
