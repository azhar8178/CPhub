modules = ["nodejs-22", "web"]
run = "pnpm dev"
hidden = [".config", ".cache", "dist", "node_modules"]

[nix]
channel = "stable-24_11"

[deployment]
deploymentTarget = "autoscale"
build = ["pnpm", "install", "--frozen-lockfile=false"]
run = ["sh", "-c", "pnpm --filter @cphub/api start"]

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 5174
externalPort = 3002

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
