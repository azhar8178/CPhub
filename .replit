modules = ["nodejs-22", "web"]
run = "pnpm dev"
hidden = [".config", ".cache", "dist", "node_modules"]

[nix]
channel = "stable-24_11"

[deployment]
deploymentTarget = "autoscale"
build = ["pnpm", "install", "--frozen-lockfile=false"]
run = ["sh", "-c", "pnpm --filter @cphub/api start"]

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173

[agent]
expertMode = true
